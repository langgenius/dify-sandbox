#include <tunables/global>
# Loaded only into a fresh disposable CI host. Wrapper authority is inherited;
# payload chroot, UID map and native seccomp still form the execution boundary.
profile dify-builder-ci flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  userns,
  /conformance-candidate rix,
  /request-worker rix,
  /network-gateway rix,
  /usr/** rmix,
  /bin/** rix,
  /lib{,32,64}/** rmix,
  /environment-root/ r,
  /environment-root/** rmix,
  /var/lib/dify-builder-ci/image/** rmix,
  /qualification/ r,
  /qualification/** r,
  /state/ rw,
  /state/** rwklix,
  /observations/ rw,
  /observations/** rwk,
  /work/ rw,
  /work/** rwkix,
  /delegated/ rw,
  /delegated/** rw,
  /sys/fs/cgroup/system.slice/dify-builder-candidate.service/** rw,
  /proc/ r,
  /proc/** r,
  /proc/[0-9]*/{uid_map,gid_map,setgroups} w,
  /dev/{null,zero,random,urandom} rw,
  /etc/{ld.so.cache,nsswitch.conf,hosts,resolv.conf,passwd,group,localtime} r,
  /etc/ssl/** r,
  /tmp/ rw,
  /tmp/** rwk,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix stream,
  network unix seqpacket,
  capability sys_admin,
  capability sys_chroot,
  capability setuid,
  capability setgid,
  capability dac_override,
  # These exist only in the freshly owned request user namespace. Candidate's
  # systemd bounding set does not grant them in the host/outer namespace.
  capability net_admin,
  capability setpcap,
  ptrace (read,readby) peer=dify-builder-ci,
  signal (send,receive) peer=dify-builder-ci,
  signal (receive) peer=unconfined,
  mount options=(rw, rprivate) -> /,
  mount options=(bind) /environment-root/ -> /state/work/request-*/,
  mount options=(ro,remount,bind,nosuid,nodev) -> /state/work/request-*/,
  mount fstype=tmpfs -> /state/work/request-*/work/,
}

# Separate ordinary endpoint keeps its native runner/filter behavior. It can
# reach only the route-less outer fixture and writes only its synthetic state.
profile dify-builder-ordinary-ci flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  /main rix,
  /usr/** rmix,
  /bin/** rix,
  /lib{,32,64}/** rmix,
  /var/lib/dify-builder-ci/image/** rmix,
  /var/sandbox/ rw,
  /var/sandbox/** rwklmix,
  /dependencies/ rw,
  /dependencies/** rwk,
  /conf/ r,
  /conf/** r,
  /tmp/ rw,
  /tmp/** rwklmix,
  /proc/ r,
  /proc/** r,
  /dev/{null,zero,random,urandom} rw,
  /etc/{ld.so.cache,nsswitch.conf,hosts,resolv.conf,passwd,group,localtime} r,
  /etc/ssl/** r,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix stream,
  capability sys_chroot,
  capability setuid,
  capability setgid,
  capability dac_override,
  signal (send,receive) peer=dify-builder-ordinary-ci,
  signal (receive) peer=unconfined,
}
