[Unit]
Description=Disposable Builder actual-image conformance supervisor
Requires=dify-builder-canary.service
After=dify-builder-canary.service

[Service]
Type=simple
User=dify-builder-ci
Group=dify-builder-ci
RootDirectory=/var/lib/dify-builder-ci/image
MountAPIVFS=yes
NetworkNamespacePath=/run/netns/dify-builder-ci
Delegate=cpu memory pids
DelegateSubgroup=manager
CPUQuota=100%
MemoryMax=4G
TasksMax=512
LimitNOFILE=4096
RuntimeMaxSec=1200
TimeoutStopSec=10
KillMode=control-group
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=accept accept4 access arch_prctl bind brk capget capset chdir chmod chown chroot clock_gettime clock_nanosleep clone clone3 close close_range connect copy_file_range dup dup2 dup3 epoll_create epoll_create1 epoll_ctl epoll_pwait epoll_pwait2 epoll_wait eventfd eventfd2 execve execveat exit exit_group faccessat faccessat2 fadvise64 fallocate fchdir fchmod fchmodat fchmodat2 fchown fchownat fcntl fdatasync flock fork fstat fstatfs fsync ftruncate futex futex_waitv getcwd getdents getdents64 getegid geteuid getgid getgroups getpeername getpgid getpgrp getpid getppid getrandom getresgid getresuid getrlimit getrusage getsid getsockname getsockopt gettid gettimeofday getuid ioctl kill lchown link linkat listen lseek lstat madvise membarrier memfd_create mincore mkdir mkdirat mmap mount mount_setattr mprotect mremap munmap nanosleep newfstatat open openat openat2 pipe pipe2 pidfd_open pidfd_send_signal poll ppoll prctl pread64 preadv preadv2 prlimit64 pselect6 pwrite64 pwritev pwritev2 read readahead readlink readlinkat readv recvfrom recvmmsg recvmsg rename renameat renameat2 restart_syscall rseq rt_sigaction rt_sigpending rt_sigprocmask rt_sigqueueinfo rt_sigreturn rt_sigsuspend rt_sigtimedwait sched_getaffinity sched_getparam sched_getscheduler sched_setaffinity sched_yield select sendfile sendmmsg sendmsg sendto set_robust_list set_tid_address setgid setgroups setpgid setresgid setresuid setrlimit setsid setsockopt setuid shutdown sigaltstack socket socketpair splice stat statfs statx symlink symlinkat sysinfo tgkill time timer_create timer_delete timer_gettime timer_settime timerfd_create timerfd_gettime timerfd_settime times tkill truncate umask umount2 uname unlink unlinkat utime utimensat utimes vfork wait4 waitid write writev
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
BindReadOnlyPaths=/var/lib/dify-builder-ci/qualification:/qualification
BindPaths=/var/lib/dify-builder-ci/state:/state
BindPaths=/var/lib/dify-builder-ci/observations:/observations
BindPaths=/sys/fs/cgroup/system.slice/dify-builder-candidate.service:/delegated
ReadWritePaths=/state /observations /delegated
AppArmorProfile=dify-builder-ci
Environment=SANDBOX_PROFILE=builder
ExecStart=/bin/sh /qualification/start-candidate.sh
